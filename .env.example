# Copiar a .env.local para desarrollo, o cargar en Vercel > Settings > Environment Variables.
# Todas son opcionales. Mientras estén vacías, el elemento que dependa de ellas se oculta en producción.

# Dominio público (canonical, hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=https://camipaganelli.com.ar

# Enlace completo de WhatsApp, por ejemplo https://wa.me/549...
NEXT_PUBLIC_WHATSAPP_URL=

# Enlace de la agenda para reservar (Sesión Claridad / llamada intro)
NEXT_PUBLIC_BOOKING_URL=

# Archivo del CV (por ejemplo /cv-cami-paganelli.pdf si se sube a /public) y URL de LinkedIn
NEXT_PUBLIC_CV_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Destino del formulario del programa comunitario (recibe un POST JSON).
# Sin este valor el formulario no se muestra en producción.
NEXT_PUBLIC_FORM_ENDPOINT=

# 1 = habilita /casos y los enlaces "Ver casos de negocio" (hoy ocultos)
NEXT_PUBLIC_ENABLE_CASOS=

# 1 = muestra los marcadores [PENDIENTE] también en producción/preview
NEXT_PUBLIC_SHOW_PENDING=
